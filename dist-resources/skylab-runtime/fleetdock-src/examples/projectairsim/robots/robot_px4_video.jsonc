{
  "base-robot-config": "robot_quadrotor_px4_sitl_wsl2.jsonc",
  "sensor-overrides": [
    {
      "id": "DownCamera",
      "enabled": false
    }
  ],
  "additional-sensors": [
    {
      "id": "FrontCamera",
      "type": "camera",
      "enabled": true,
      "parent-link": "Frame",
      "capture-interval": 0.0333333333,
      "capture-settings": [
        {
          "image-type": 0,
          "width": 960,
          "height": 540,
          "fov-degrees": 90,
          "capture-enabled": true,
          "streaming-enabled": true,
          "pixels-as-float": false,
          "compress": false,
          "target-gamma": 2.5
        }
      ],
      "origin": {
        "xyz": "0.45 0 0",
        "rpy-deg": "0 0 0"
      }
    }
  ]
}
